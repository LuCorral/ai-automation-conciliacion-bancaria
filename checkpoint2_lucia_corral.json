        "sendTo": "lucorral8@gmail.com",
        "subject": "Tarea completada - Conciliación Bancaria",
        "message": "=<div style=\"font-family: Arial, sans-serif; line-height: 1.5; color: #222;\">\n  <h2>Tarea completada - Conciliación Bancaria M2</h2>\n\n  <p><strong>Worker invocado:</strong> {{ $json.worker }}</p>\n\n  <p><strong>Estado:</strong> {{ $json.status }}</p>\n\n  <p><strong>Consulta analizada:</strong></p>\n  <div style=\"padding: 10px; border: 1px solid #ddd; border-radius: 8px;\">\n    {{ $('Entrada de consulta').item.json.chatInput }}\n  </div>\n\n  <p><strong>Resultado devuelto:</strong></p>\n  <div style=\"padding: 10px; border: 1px solid #ddd; border-radius: 8px; white-space: pre-wrap;\">\n    {{ $json.resultado }}\n  </div>\n\n  <hr style=\"margin: 20px 0; border: none; border-top: 1px solid #ddd;\">\n\n  <div style=\"font-size: 12px; color: #666;\">\n    Estado final: Tarea completada.\n  </div>\n</div>",
